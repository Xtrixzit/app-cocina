    <!-- Privacy Policy -->
    <string name="privacy_title">Política de Privacidad</string>
    <string name="privacy_body">• Modo Invitado: toda tu información (recetas, despensa, compras, fotos e historial) permanece únicamente en el almacenamiento local de tu dispositivo.\n\n• Cuenta Google: tus datos se guardan de forma privada bajo tu propio identificador de Google en Cloud Firestore. Ningún otro usuario puede leerlos ni modificarlos.\n\n• Asistentes de voz (AppFunctions / App Actions): solo exponen resúmenes de inventario, recetas y compras al asistente del sistema cuando está habilitado en tu teléfono.\n\n• Control total: puedes exportar tus datos en JSON o eliminar tu cuenta y todos tus datos de forma permanente en cualquier momento desde Configuración.</string>

    <!-- Auth Screen -->
    <string name="auth_title">Recetario &amp; Despensa</string>
    <string name="auth_subtitle">Conecta tu cuenta Google para respaldar recetas, inventario y costos en la nube, y responder consultas con el asistente de voz de tu teléfono.</string>
    <string name="auth_feat_cloud_title">Sincronización en la Nube</string>
    <string name="auth_feat_cloud_desc">Tus recetas, inventario y precios seguros con tu cuenta de Google en todos tus dispositivos.</string>
    <string name="auth_feat_voice_title">Respuestas Sin Abrir la App</string>
    <string name="auth_feat_voice_desc">Compatible con AppFunctions y App Actions para que cualquier asistente de voz o IA del sistema consulte tu despensa, compras y recetas.</string>
    <string name="auth_feat_timer_title">Viabilidad y Temporizador</string>
    <string name="auth_feat_timer_desc">Comprueba al instante qué recetas puedes cocinar con tu inventario actual y controla tiempos.</string>
    <string name="auth_feat_prod_title">Cálculo de Producción</string>
    <string name="auth_feat_prod_desc">Escala lotes por porciones, tandas o ingrediente clave y conoce tu margen de ganancia.</string>

    <!-- Account & About Dialogs -->
    <string name="account_guest_title">Modo Invitado (Solo local)</string>
    <string name="account_guest_active">Sesión activa: Invitado en este dispositivo</string>
    <string name="account_guest_desc">Toda tu información (recetas, despensa y lista de compras) se guarda únicamente en este dispositivo y NO se sube a la nube.\n\nSi conectas una cuenta Google más adelante, podrás decidir si migrar o mantener separados los datos locales.</string>

    <!-- Privacy Policy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_body">• Guest Mode: all your data (recipes, pantry, shopping list, photos, and history) stays strictly in local device storage.\n\n• Google Account: your data is privately stored under your own Google user ID in Cloud Firestore. No other user can read or modify it.\n\n• Voice Assistants (AppFunctions / App Actions): only expose pantry, recipe, and shopping summaries to the system assistant when enabled on your phone.\n\n• Full Control: you can export all data as JSON or permanently delete your account and cloud data anytime from Settings.</string>

    <!-- Auth Screen -->
    <string name="auth_title">Recetario &amp; Pantry</string>
    <string name="auth_subtitle">Connect your Google account to back up recipes, inventory and costs to the cloud, and answer queries via your Android voice assistant.</string>
    <string name="auth_feat_cloud_title">Cloud Synchronization</string>
    <string name="auth_feat_cloud_desc">Your recipes, stock, and unit prices kept safe across all your devices with Google.</string>
    <string name="auth_feat_voice_title">Answers Without Opening the App</string>
    <string name="auth_feat_voice_desc">Supports Android AppFunctions &amp; App Actions so any system voice assistant or AI agent can check your pantry, shopping list, and recipes.</string>
    <string name="auth_feat_timer_title">Feasibility &amp; Timers</string>
    <string name="auth_feat_timer_desc">Instantly see which recipes you can cook with current inventory and track cooking times.</string>
    <string name="auth_feat_prod_title">Production &amp; Margin Calculator</string>
